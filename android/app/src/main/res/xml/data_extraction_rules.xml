<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ (android:dataExtractionRules): keep the workspaces prefs (they hold bearer tokens) out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tobor_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tobor_settings.xml" />
    </device-transfer>
</data-extraction-rules>

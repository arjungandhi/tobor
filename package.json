{
  "name": "tobor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun run --bun vitest run",
    "typecheck": "bun x tsc --noEmit",
    "gen:assets": "bun build/gen-assets.ts",
    "build": "bun run gen:assets && bun build --compile --minify --bytecode --format=esm --target=bun-linux-x64-baseline build/compile-entry.ts --outfile dist/tobor",
    "build:arm64": "bun run gen:assets && bun build --compile --minify --bytecode --format=esm --target=bun-linux-arm64 build/compile-entry.ts --outfile dist/tobor-arm64"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "cron-parser": "5.10.4",
    "ws": "8.22.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}

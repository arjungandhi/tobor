{
  "name": "tobor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "tobor": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:node": "node --import tsx src/cli.ts node",
    "dev:tui": "node --import tsx src/cli.ts tui"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@earendil-works/pi-durable": "1.5.1",
    "@earendil-works/pi-schema": "1.5.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

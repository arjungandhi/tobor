[Unit]
Description=tobor node
After=network-online.target

[Service]
Environment=TOBOR_HOME=/home/monkey/repos/github.com/arjungandhi
Environment=PATH=/usr/bin:/home/monkey/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /home/monkey/repos/github.com/arjungandhi/tobor/dist/cli.js node
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target

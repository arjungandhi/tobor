[Unit]
Description=tobor node (%i)
After=network-online.target

[Service]
EnvironmentFile=%h/.config/tobor/nodes/%i.env
ExecStart=%h/.local/bin/tobor node
Restart=on-failure
# POST /api/upgrade and /api/restart stop the node with exit code 75; relaunch it even though that is a clean-looking exit.
RestartForceExitStatus=75
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target

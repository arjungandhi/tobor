[Unit]
Description=tobor node (%i)
After=network-online.target

[Service]
EnvironmentFile=%h/.config/tobor/nodes/%i.env
ExecStart=%h/.local/bin/tobor node
Restart=on-failure
# Exit code 75 = deliberate restart (POST /api/upgrade, POST /api/restart): always relaunch.
RestartForceExitStatus=75
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
